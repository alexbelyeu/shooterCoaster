{
  "name": "shootercoaster",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:portal": "tsc -b && vite build --mode portal && node scripts/portal/package.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node e2e/smoke.mjs --mobile",
    "smoke:portal": "node e2e/smoke.mjs --dist dist-portal --base /nested/path/ --levels level1",
    "check:bundle": "node scripts/check-bundle.mjs",
    "og": "node scripts/og-image.mjs",
    "clip": "node scripts/clip.mjs",
    "audio:render": "node scripts/audio/render.mjs",
    "audio:check": "node scripts/audio/check.mjs",
    "verify": "npm test && npm run build && npm run check:bundle && npm run lighthouse && npm run smoke",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "@vercel/analytics": "2.0.1",
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "tone": "^15.0.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.0",
    "lighthouse": "13.5.0",
    "playwright": "^1.58.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
