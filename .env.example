# Server-side only: read by api/leaderboard.ts and api/telemetry.ts (Vercel Functions), never by the game in the browser.
# Set in the Vercel project's Production env vars (docs/LEADERBOARD.md). Leave unset locally:
# the API then answers 503 and the game keeps its local board.
SUPABASE_URL=
# A Supabase secret key (sb_secret_...), never the publishable/anon key.
SUPABASE_SECRET_KEY=
