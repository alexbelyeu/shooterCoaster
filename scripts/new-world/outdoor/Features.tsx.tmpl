import { useEffect, useMemo } from 'react'
import * as THREE from 'three'
import type { BiomeFeaturesProps } from '../../shared/types'
import { trackExtent } from '../../shared/trackScatter'

/** Height of the stand-in landmark (world units). */
const SPIRE_HEIGHT = 420

/** A stone spire beyond the track: the stand-in for this world's hero landmark (docs/LEVEL-KIT.md). */
export default function __Biome__Features({ groundFn, track }: BiomeFeaturesProps) {
  const geometry = useMemo(() => new THREE.ConeGeometry(70, SPIRE_HEIGHT, 5).translate(0, SPIRE_HEIGHT / 2, 0), [])
  const material = useMemo(() => new THREE.MeshStandardMaterial({ color: 0x7a7068, roughness: 0.85, flatShading: true }), [])
  const position = useMemo(() => {
    const r = trackExtent(track) * 1.3
    const x = r * 0.6
    const z = -r * 0.8
    return [x, groundFn(x, z) - 10, z] as const
  }, [groundFn, track])

  useEffect(
    () => () => {
      geometry.dispose()
      material.dispose()
    },
    [geometry, material],
  )

  return <mesh geometry={geometry} material={material} position={position} />
}
