title    Sunbleached
composer Claude (ShooterCoaster placeholder)
about    Placeholder Desert score that proves the score engine. Harmonic-minor oboe over guitar arpeggios and hand drums on a straight kick.
tempo    140
beats    4
steps    2
reverb   0.3

voice lead   oboe     vol=0.75 pan=-0.1
voice gtr    guitar   vol=0.6  pan=0.3
voice bass   fretless vol=0.8  oct=1
voice kick   kick     vol=0.8
voice conga  conga    vol=0.5  pan=-0.35
voice bongo  bongo    vol=0.45 pan=0.35
voice tamb   tamb     vol=0.4  pan=0.45

pattern intro
gtr   | A3 E4 A4 C5 A4 E4 A3 E4 | E3 B3 E4 G#4 E4 B3 E3 B3 |
conga | ..x. x.xx | ..x. xxxx |

pattern A
lead  | A4- C5 B4 A4- E5- | D5 C5 B4 C5 D5--- | C5 B4 A4 G#4 A4- C5- | B4--- G#4- E4- |
gtr   | A3 E4 A4 C5 A4 E4 A3 E4 | G3 D4 G4 B4 G4 D4 G3 D4 | F3 C4 F4 A4 F4 C4 F3 C4 | E3 B3 E4 G#4 E4 B3 E3 B3 |
bass  | A1--- A1- E2- | G1--- G1- D2- | F1--- F1- C2- | E1--- E1- B1- |
kick  | x... x... | % | % | % |
conga | ..x. x.xx | % | % | % |
bongo | .x.. .x.x | % | % | % |
tamb  | .x.x .x.x | % | % | % |

pattern B
lead  | F5- E5 D5 F5- A5- | E5- C5 B4 A4--- | G#4 A4 B4 C5 D5 C5 B4 G#4 | A4------- |
gtr   | D3 A3 D4 F4 D4 A3 D3 A3 | A3 E4 A4 C5 A4 E4 A3 E4 | E3 B3 E4 G#4 E4 B3 E3 B3 | A3 E4 A4 C5 E5--- |
bass  | D2--- D2- A1- | A1--- A1- E2- | E1--- E1- B1- | A1--- A1- E2- |
kick  | x... x... | % | % | % |
conga | ..x. x.xx | % | % | ..x. xxXX |
bongo | .x.. .x.x | % | % | % |
tamb  | .x.x .x.x | % | % | % |

play intro
loop A B
