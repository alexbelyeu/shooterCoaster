title    Souk Chase
composer Claude (ShooterCoaster)
about    Desert option "caravan": a snake-charmer oboe hook in E harmonic minor over a saidi darbuka groove (tumba doum, bongo tek, finger-cymbal triangle) and plucked string chords, with synth-brass stabs. The last eight bars lift the hook a minor third. Layers: pizzicato, FM bass and darbuka, then kick, clap and shaker at 2x, the oboe at 3x, synth brass and a tambourine at FRENZY.
tempo    138
beats    4
steps    4
reverb   0.3

# untagged voices are the base layer; the intro plays every layer
voice pizz   pizz      vol=0.42 pan=0.3  center=E4 gate=0.6
voice bass   fmbass    vol=0.64 gate=0.75
voice doum   tumba     vol=0.55 pan=-0.15
voice tek    bongo     vol=0.58 pan=0.3
voice kick   kick      vol=0.82 layer=drums
voice clap   clap909   vol=0.42 pan=0.05 layer=drums
voice shake  shaker    vol=0.36 pan=-0.4 layer=drums
voice tri    tri       vol=0.22 pan=0.5  layer=drums
voice hit    orchhit   vol=0.38 layer=drums
voice oboe   oboe      vol=0.8  pan=-0.05 rev=0.32 layer=lead
voice brass  synbrass  vol=0.3  pan=-0.35 center=E4 gate=0.45 layer=frenzy
voice tamb   tamb      vol=0.34 pan=0.45 layer=frenzy

pattern intro
oboe  | B4------- ~E5------- | D#5- E5- F#5- G5- F#5- E5- D#5- B4- |
doum  | X... ..x. x... .... | X... ..x. XxXx XXXX |
tek   | ..xo .... ..o. x.xo | ..xo .... .... .... |
hit   | [Em]!--------------- | _ |

pattern A
oboe  | E5--- D#5- E5- F#5- G5- F#5- E5- | B4------- C5- B4- A4- G4- | A4- B4- C5- D#5- E5--- D#5- C5- | B4----------- .--- |
pizz  | [Em]- .- [Em]- [Em]- .- [Em]- [Em]- .- | % | [Am]- .- [Am]- [Am]- .- [Am]- [Am]- .- | [B7]- .- [B7]- [B7]- .- [B7]- [B7]- .- |
bass  | E2- .- E2- E2- .- E3- B2- .- | % | A2- .- A2- A2- .- A3- E3- .- | B2- .- B2- B2- .- B3- F#3- .- |
doum  | X... ..x. x... .... | % | % | X... ..x. x... x.x. |
tek   | ..xo .... ..o. x.xo | % | % | ..xo .... xxxx xxxx |
kick  | x... ..x. x... .... | % | % | % |
clap  | .... x... .... x... | % | % | .... x... .... x.xx |
shake | x.xo x.xo x.xo x.xo | % | % | % |
tri   | ..x. ..x. ..x. ..x. | % | % | % |
hit   | [Em]-- .------------ | _ | _ | _ |
brass | [Em]- .- [Em]- [Em]- .- [Em]- [Em]- .- | % | [Am]- .- [Am]- [Am]- .- [Am]- [Am]- .- | [B7]- .- [B7]- [B7]- .- [B7]- [B7]- .- |
tamb  | xoxo xoxo xoxo xoxo | % | % | % |

pattern A2 from A
oboe  | E5--- D#5- E5- F#5- G5- F#5- E5- | B4------- C5- B4- A4- G4- | A4- B4- C5- B4- A4- G4- F#4- G4- | F#4- G4- F#4- D#4- E4------- |
pizz  | [Em]- .- [Em]- [Em]- .- [Em]- [Em]- .- | % | [Am]- .- [Am]- [Am]- .- [Am]- [Am]- .- | [B7]- .- [B7]- [B7]- [Em]------- |
hit   | _ | _ | _ | _ |

pattern B from A
oboe  | G5------- E5--- G5- A5- | F#5------- D5--- E5- F#5- | G5- F#5- E5- D#5- E5- F#5- D#5- B4- | E5----------- .--- |
pizz  | [C]- .- [C]- [C]- .- [C]- [C]- .- | [D]- .- [D]- [D]- .- [D]- [D]- .- | [B7]- .- [B7]- [B7]- .- [B7]- [B7]- .- | [Em]- .- [Em]- [Em]- .- [Em]- [Em]- .- |
bass  | C3- .- C3- C3- .- C4- G3- .- | D2- .- D2- D2- .- D3- A2- .- | B2- .- B2- B2- .- B3- F#3- .- | E2- .- E2- E2- .- E3- B2- .- |
brass | [C]------- [C]--- .--- | [D]------- [D]--- .--- | [B7]------- [B7]--- .--- | [Em]------- [Em]--- .--- |
hit   | [C]-- .------------ | _ | _ | _ |

pattern B2 from B
oboe  | G5------- E5--- G5- A5- | F#5------- D5--- E5- F#5- | A5- G5- F#5- E5- D#5- E5- F#5- A5- | B5----------- .--- |
pizz  | [C]- .- [C]- [C]- .- [C]- [C]- .- | [D]- .- [D]- [D]- .- [D]- [D]- .- | [B7]- .- [B7]- [B7]- .- [B7]- [B7]- .- | [B7]- .- [B7]- [B7]- .- [B7]- [B7]- .- |
bass  | C3- .- C3- C3- .- C4- G3- .- | D2- .- D2- D2- .- D3- A2- .- | B2- .- B2- B2- .- B3- F#3- .- | B2- .- B2- B2- .- B3- F#3- .- |
brass | [C]------- [C]--- .--- | [D]------- [D]--- .--- | [B7]------- [B7]--- .--- | [B7]------- [B7]--- .--- |
doum  | X... ..x. x... .... | % | % | X..x X..x XxXx XXXX |
tek   | ..xo .... ..o. x.xo | % | % | .... .... .... .... |
hit   | [C]-- .------------ | _ | _ | [B7]!-- .- [B7]!-- .- [B7]!--- . . |

play intro
loop A A2 B B2 A A2 A+3 A2+3
