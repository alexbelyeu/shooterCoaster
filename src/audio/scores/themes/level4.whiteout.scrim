title    Whiteout
composer Claude (ShooterCoaster)
about    Antarctica option "whiteout": a fast breakbeat blizzard in B minor at 172. A glockenspiel runs a sixteenth-note ice ostinato over a stuttering FM bass, a two-step break drives it, and a supersaw carries the hook. The last eight bars lift a tone. Layers: glockenspiel and bass, then the break at 2x, the supersaw at 3x, a celesta an octave up and an open hat at FRENZY.
tempo    172
beats    4
steps    4
reverb   0.3

# untagged voices are the base layer; the intro plays every layer
voice ice    glock     vol=0.24 pan=0.35
voice bass   fmbass    vol=0.68 gate=0.8
voice kick   bigkick   vol=0.62 layer=drums
voice snare  snare     vol=0.62 pan=0.05 layer=drums
voice hat    hat909    vol=0.3  pan=-0.3 layer=drums
voice crash  crash     vol=0.32 pan=-0.2 layer=drums
voice rise   riser     vol=0.26 layer=drums
voice lead   supersaw  vol=0.7  layer=lead
voice cel    celesta   vol=0.38 pan=-0.3 oct=1 layer=frenzy
voice ohat   ohat909   vol=0.22 pan=0.4 layer=frenzy

pattern intro
ice   | B5 D6 F#6 D6 B5 D6 F#6 D6 B5 D6 F#6 D6 B5 D6 F#6 D6 | A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 |
rise  | _ | B5--------------- |
snare | .... .... .... .... | x.x. x.x. xxxx XXXX |

pattern A
lead  | F#5--- D5--- B4- C#5- D5- F#5- | G5------- F#5- E5- D5- B4- | C#5--- E5--- A5--- G5- F#5- | F#5----------- A#4- C#5- |
ice   | B5 D6 F#6 D6 B5 D6 F#6 D6 B5 D6 F#6 D6 B5 D6 F#6 D6 | B5 D6 G6 D6 B5 D6 G6 D6 B5 D6 G6 D6 B5 D6 G6 D6 | A5 C#6 E6 C#6 A5 C#6 E6 C#6 A5 C#6 E6 C#6 A5 C#6 E6 C#6 | A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 |
bass  | B2--- .- B2- .- B2- A2- F#2- | G2--- .- G2- .- G2- A2- B2- | A2--- .- A2- .- A2- G2- E2- | F#2--- .- F#2- .- F#2- A#2- C#3- |
kick  | x... .... ..x. .... | x... .... ..x. ..x. | x... .... ..x. .... | x... .... ..x. .x.. |
snare | .... x..o .o.. x... | % | % | .... x..o .o.. x.xx |
hat   | x.x. x.x. x.x. x.x. | % | % | % |
crash | X... .... .... .... | _ | _ | _ |
cel   | F#5--- D5--- B4- C#5- D5- F#5- | G5------- F#5- E5- D5- B4- | C#5--- E5--- A5--- G5- F#5- | F#5----------- A#4- C#5- |
ohat  | ..x. ..x. ..x. ..x. | % | % | % |

pattern A2 from A
lead  | F#5--- D5--- B4- C#5- D5- F#5- | G5------- F#5- E5- D5- B4- | C#5--- E5--- A5--- G5- F#5- | F#5------- E5- D5- C#5- A#4- |
cel   | F#5--- D5--- B4- C#5- D5- F#5- | G5------- F#5- E5- D5- B4- | C#5--- E5--- A5--- G5- F#5- | F#5------- E5- D5- C#5- A#4- |
crash | _ | _ | _ | _ |

pattern B from A
lead  | G5------- B5------- | D6------- B5--- G5--- | F#5- B5- D6- F#6- E6--- D6--- | C#6------- A#5------- |
cel   | G5------- B5------- | D6------- B5--- G5--- | F#5- B5- D6- F#6- E6--- D6--- | C#6------- A#5------- |
ice   | G5 B5 E6 B5 G5 B5 E6 B5 G5 B5 E6 B5 G5 B5 E6 B5 | B5 D6 G6 D6 B5 D6 G6 D6 B5 D6 G6 D6 B5 D6 G6 D6 | B5 D6 F#6 D6 B5 D6 F#6 D6 B5 D6 F#6 D6 B5 D6 F#6 D6 | A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 A#5 C#6 F#6 C#6 |
bass  | E2--- .- E2- .- E2- F#2- G2- | G2--- .- G2- .- G2- A2- B2- | B2--- .- B2- .- B2- A2- F#2- | F#2--- .- F#2- .- F#2- A#2- C#3- |
crash | X... .... .... .... | _ | _ | _ |

pattern B2 from B
rise  | _ | _ | _ | B5--------------- |
snare | .... x..o .o.. x... | % | % | x.x. x.x. xxxx XXXX |

play intro
loop A A2 B B2 A A2 A+2 A2+2
