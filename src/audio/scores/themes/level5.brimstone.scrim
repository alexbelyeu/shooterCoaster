title    Brimstone
composer Claude (ShooterCoaster)
about    Inferno option "brimstone": arcade metal in E minor at 176. Palm-muted power-chord chugs and FM bass hold the floor, a distorted lead arpeggiates the hook under a choir, and timpani and orchestra hits mark the bars. The last eight bars lift a semitone, to F minor. Layers: the chug riff and bass, then the kit, timpani and orchestra hits at 2x, the lead guitar and choir at 3x, a sixteenth-note double kick and choir stabs at FRENZY.
tempo    176
beats    4
steps    4
reverb   0.22

# untagged voices are the base layer; the intro plays every layer
voice chug   distguitar vol=0.3  pan=0.4  gate=0.5
voice bass   fmbass     vol=0.6  gate=0.7
voice kick   bigkick    vol=0.55 layer=drums
voice snare  snare      vol=0.64 pan=0.05 layer=drums
voice ride   ride       vol=0.26 pan=-0.3 layer=drums
voice crash  crash      vol=0.34 pan=-0.2 layer=drums
voice timp   timpani    vol=0.4  pan=-0.1 layer=drums
voice hit    orchhit    vol=0.4  layer=drums
voice lead   distguitar vol=0.55 pan=-0.25 layer=lead
voice choir  choir      vol=0.6  pan=0.1 layer=lead
voice dkick  kick       vol=0.3  layer=frenzy
voice stab   voices     vol=0.36 pan=0.3 center=E4 gate=0.4 layer=frenzy

pattern intro
hit   | [Em]!--- .--- [Em]!--- .--- | [C]!--- [D]!--- [B]!------- |
timp  | E2--- .--- E2--- .--- | C3--- D3--- B2- B2- B2 B2 B2 B2 |
choir | [Em]--------------- | [B]--------------- |
snare | .... .... .... .... | .... .... xxxx XXXX |

pattern A
chug  | E2+B2 E2+B2 . E2+B2 E2+B2 . G2+D3- E2+B2 E2+B2 . E2+B2 F#2+C#3- E2+B2 . | C3+G3 C3+G3 . C3+G3 C3+G3 . D3+A3- C3+G3 C3+G3 . C3+G3 B2+F#3- C3+G3 . | D3+A3 D3+A3 . D3+A3 D3+A3 . E3+B3- D3+A3 D3+A3 . D3+A3 C3+G3- D3+A3 . | B2+F#3 B2+F#3 . B2+F#3 B2+F#3 . B2+F#3- D#3+A#3- . B2+F#3- B2+F#3-- |
bass  | E2 E2 . E2 E2 . G2- E2 E2 . E2 F#2- E2 . | C3 C3 . C3 C3 . D3- C3 C3 . C3 B2- C3 . | D2 D2 . D2 D2 . E2- D2 D2 . D2 C3- D2 . | B2 B2 . B2 B2 . B2- D#3- . B2- B2-- |
lead  | E4- G4- B4- D#5- B4- G4- E4- G4- | C5- B4- G4- E4- G4- C5- B4- G4- | A4- F#4- D4- F#4- A4- D5- C5- A4- | B4--- D#5--- F#4--- A4- B4- |
choir | [Em]--------------- | [C]--------------- | [D]--------------- | [B]--------------- |
kick  | x.x. x... x.x. x... | % | % | x.x. x... xxxx x.x. |
snare | .... X... .... X... | % | % | .... X... ..X. X.XX |
ride  | x.x. x.x. x.x. x.x. | % | % | % |
crash | X... .... .... .... | _ | _ | _ |
timp  | E2--- .--- .--- .--- | C3--- .--- .--- .--- | D3--- .--- .--- .--- | B2--- .--- B2- B2- B2 B2 B2 B2 |
hit   | [Em]!--- .----------- | _ | _ | _ |
dkick | x.x. x.x. x.x. x.x. | % | % | xxxx xxxx xxxx xxxx |
stab  | [Em]- .- .- [Em]- .- .- [Em]- .- | [C]- .- .- [C]- .- .- [C]- .- | [D]- .- .- [D]- .- .- [D]- .- | [B]- .- .- [B]- .- .- [B]- .- |

pattern A2 from A
lead  | E4- G4- B4- D#5- B4- G4- E4- G4- | C5- B4- G4- E4- G4- C5- B4- G4- | A4- F#4- D4- F#4- A4- D5- C5- A4- | D#5- B4- F#4- D#4- B3--- F#3--- |
hit   | _ | _ | _ | [B]!--- [B]!--- [B]!------- |
crash | _ | _ | _ | _ |

pattern B from A
chug  | A2+E3 A2+E3 . A2+E3 A2+E3 . C3+G3- A2+E3 A2+E3 . A2+E3 G2+D3- A2+E3 . | E2+B2 E2+B2 . E2+B2 E2+B2 . G2+D3- E2+B2 E2+B2 . E2+B2 F#2+C#3- E2+B2 . | C3+G3 C3+G3 . C3+G3 C3+G3 . D3+A3- C3+G3 C3+G3 . C3+G3 B2+F#3- C3+G3 . | B2+F#3 B2+F#3 . B2+F#3 B2+F#3 . B2+F#3- D#3+A#3- . B2+F#3- B2+F#3-- |
bass  | A2 A2 . A2 A2 . C3- A2 A2 . A2 G2- A2 . | E2 E2 . E2 E2 . G2- E2 E2 . E2 F#2- E2 . | C3 C3 . C3 C3 . D3- C3 C3 . C3 B2- C3 . | B2 B2 . B2 B2 . B2- D#3- . B2- B2-- |
lead  | C5------- B4--- A4--- | G4------- B4------- | E5------- D5--- C5--- | B4------- A4--- D#4--- |
choir | [Am]--------------- | [Em]--------------- | [C]--------------- | [B7]--------------- |
timp  | A2--- .--- .--- .--- | E2--- .--- .--- .--- | C3--- .--- .--- .--- | B2--- .--- B2- B2- B2 B2 B2 B2 |
stab  | [Am]- .- .- [Am]- .- .- [Am]- .- | [Em]- .- .- [Em]- .- .- [Em]- .- | [C]- .- .- [C]- .- .- [C]- .- | [B7]- .- .- [B7]- .- .- [B7]- .- |
hit   | [Am]!--- .----------- | _ | _ | _ |
crash | X... .... .... .... | _ | _ | _ |

pattern B2 from B
lead  | C5------- B4--- A4--- | G4------- B4------- | E5------- D5--- C5--- | D#5- B4- F#4- D#4- B3--- F#3--- |
hit   | [Am]!--- .----------- | _ | _ | [B]!--- [B]!--- [B]!------- |
snare | .... X... .... X... | % | % | ..x. x.x. xxxx XXXX |

play intro
loop A A2 B B2 A A2 A+1 A2+1
