brass | .- [Gmaj7]- .- [Gmaj7]- .- [Gmaj7]- .- [Gmaj7]- | .- [A]- .- [A]- .- [A]- .- [A]- | .- [Bm]- .- [Bm]- .- [Bm]- .- [Bm]- | .- [F#]- .- [F#]- .- [F#7]- .- [F#7]- |
